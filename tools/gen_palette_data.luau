--!nocheck
-- Writes src/theme/PaletteData.luau from tools/palette.json (made by tools/gen_palette.py).
-- Usage, from the repository root: lune run tools/gen_palette_data.luau
-- Each theme becomes one string of 6-digit hex values in ORDER, so the bundle carries
-- about 3 KB for all 12 palettes and nothing is decoded until a theme is first used.

local fs = require("@lune/fs")
local serde = require("@lune/serde")

local ORDER = {
	"Frame", "Sheet", "Surface", "Hover", "Active", "Raised", "Well", "Track", "Border", "BorderSoft",
	"Text", "Text2", "Muted", "Dim", "Disabled", "Accent", "AccentHi", "AccentDeep", "AccentAlt",
	"AccentText", "OnAccent", "AccentSoft", "Focus", "Success", "Warning", "Danger", "Info",
	"SuccessSoft", "WarningSoft", "DangerSoft", "InfoSoft", "OnStatus",
}
local THEMES = { "Argon", "Amethyst", "Midnight", "Emerald", "Rose", "Slate", "Ember", "Nord", "Mono", "Ocean", "Daylight", "HighContrast" }

local source = fs.readFile("tools/palette.json")
local data = serde.decode("json", source)
local hash = serde.hash("sha256", source)

local lines = {
	"-- GENERATED by tools/gen_palette_data.luau from tools/palette.json (sha256 " .. hash .. "). Do not edit.",
	"return {",
	"\thash = \"" .. hash .. "\",",
	"\torder = { \"" .. table.concat(ORDER, "\", \"") .. "\" },",
	"\tnames = { \"" .. table.concat(THEMES, "\", \"") .. "\" },",
	"\tthemes = {",
}
for _, name in ipairs(THEMES) do
	local palette = assert(data[name], "palette.json has no theme " .. name)
	local hex = {}
	for _, token in ipairs(ORDER) do
		local value = assert(palette[token], name .. " has no token " .. token)
		hex[#hex + 1] = value:gsub("#", ""):upper()
	end
	lines[#lines + 1] = ("\t\t%s = \"%s\","):format(name, table.concat(hex, " "))
end
lines[#lines + 1] = "\t},"
lines[#lines + 1] = "}"
lines[#lines + 1] = ""
fs.writeFile("src/theme/PaletteData.luau", table.concat(lines, "\n"))
print(("wrote src/theme/PaletteData.luau: %d themes x %d tokens"):format(#THEMES, #ORDER))
