local function safeCall(callback,...)
    if type(callback)~="function" then return end
    local ok,err=pcall(callback,...)
    if not ok then warn("[Argon UI] Callback error: "..tostring(err)) end
end

local function connect(signal,callback)
    local connection=signal:Connect(callback)
    table.insert(Argon._connections,connection)
    return connection
end

-- Key lookup order matters: pairs() over C is unordered, so a palette where two keys
-- share a colour (several themes reuse Warning/Danger) could resolve to whichever key
-- came out first and then re-theme to the wrong slot. Walking a fixed list makes the
-- resolution deterministic and puts the structural keys ahead of the semantic ones.
local THEME_KEY_ORDER={
    "Background","Window","Sidebar","Surface","Hover","Active","Input",
    "Border","BorderSoft","Text","Muted","Dim",
    "Accent","AccentLight","AccentDark","Success","Warning","Danger",
}
local function themeKeyForColor(value)
    if typeof(value)~="Color3" then return nil end
    for _,key in ipairs(THEME_KEY_ORDER) do if C[key]==value then return key end end
    for key,color in pairs(C) do if value==color then return key end end
    return nil
end

local function registerThemeBinding(object,property,value)
    local colorKey=themeKeyForColor(value)
    if colorKey then
        table.insert(Argon._themeBindings,{Object=object,Property=property,Key=colorKey})
        return
    end
    if typeof(value)=="ColorSequence" then
        local points={}
        local themed=false
        for _,point in ipairs(value.Keypoints) do
            local key=themeKeyForColor(point.Value)
            points[#points+1]={Time=point.Time,Key=key,Color=point.Value}
            themed=themed or key~=nil
        end
        if themed then table.insert(Argon._themeBindings,{Object=object,Property=property,Points=points}) end
    end
end

local function create(className,props)
    local object=Instance.new(className)
    for property,value in pairs(props or {}) do
        if property~="Parent" then
            object[property]=value
            registerThemeBinding(object,property,value)
        end
    end
    if props and props.Parent then object.Parent=props.Parent end
    return object
end

local function corner(parent,radius)
    return create("UICorner",{CornerRadius=UDim.new(0,radius or 10),Parent=parent})
end

local function stroke(parent,color,transparency,thickness)
    return create("UIStroke",{Color=color or C.Border,Transparency=transparency or 0,Thickness=thickness or 1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Parent=parent})
end

local function padding(parent,left,right,top,bottom)
    return create("UIPadding",{PaddingLeft=UDim.new(0,left or 0),PaddingRight=UDim.new(0,right or left or 0),PaddingTop=UDim.new(0,top or 0),PaddingBottom=UDim.new(0,bottom or top or 0),Parent=parent})
end

local function gradient(parent,first,second,rotation)
    return create("UIGradient",{Color=ColorSequence.new(first,second),Rotation=rotation or 0,Parent=parent})
end

local function iconLine(parent,firstPoint,secondPoint,color,thickness)
    local delta=Vector2.new(secondPoint[1]-firstPoint[1],secondPoint[2]-firstPoint[2])
    local center=Vector2.new((firstPoint[1]+secondPoint[1])/2,(firstPoint[2]+secondPoint[2])/2)
    local lineThickness=math.max(1,thickness or 1.5)
    local line=create("Frame",{AnchorPoint=Vector2.new(.5,.5),BackgroundColor3=color,BorderSizePixel=0,Position=UDim2.fromOffset(center.X,center.Y),Rotation=math.deg(math.atan2(delta.Y,delta.X)),Size=UDim2.fromOffset(math.max(1,delta.Magnitude),lineThickness),Parent=parent})
    corner(line,lineThickness)
    return line
end

-- Official Lucide icon set (https://lucide.dev) via the latte-soft/lucide-roblox
-- spritesheets, which are public Roblox image assets usable from any game. The index is
-- fetched once and cached on disk; the bundled atlas stays as an offline fallback so the
-- library never depends on network access.
local LUCIDE_INDEX_URL="https://raw.githubusercontent.com/latte-soft/lucide-roblox/master/lib/Icons.luau"
local LUCIDE_CACHE=ASSET_FOLDER.."/lucide-icons.luau"
local LUCIDE_SET=nil

local function loadLucideIndex()
    if LUCIDE_SET~=nil then return LUCIDE_SET end
    LUCIDE_SET=false
    local function parse(source)
        if type(source)~="string" or #source<1000 then return nil end
        local chunk=loadstring(source,"@lucide-icons")
        if not chunk then return nil end
        local ok,data=pcall(chunk)
        if not ok or type(data)~="table" then return nil end
        -- 48px cells stay crisp at the 14-22px sizes this UI draws.
        return data["48px"] or data["256px"] or data["16px"]
    end
    -- Resolved locally: the shared filesystem helpers are declared further down.
    local environment=getgenv and getgenv() or _G
    local function executorFunction(name)
        local candidate=environment and rawget(environment,name) or rawget(_G,name)
        return type(candidate)=="function" and candidate or nil
    end
    local reader=executorFunction("readfile")
    local writer=executorFunction("writefile")
    local checkFile=executorFunction("isfile")
    local checkFolder=executorFunction("isfolder")
    local createFolder=executorFunction("makefolder")

    if reader and checkFile then
        local exists=select(2,pcall(checkFile,LUCIDE_CACHE))
        if exists==true then
            local ok,cached=pcall(reader,LUCIDE_CACHE)
            if ok then
                local parsed=parse(cached)
                if parsed then LUCIDE_SET=parsed return LUCIDE_SET end
            end
        end
    end

    local ok,source=pcall(function() return game:HttpGet(LUCIDE_INDEX_URL) end)
    if ok then
        local parsed=parse(source)
        if parsed then
            LUCIDE_SET=parsed
            if writer then
                if createFolder then
                    local present=checkFolder and select(2,pcall(checkFolder,ASSET_FOLDER))
                    if present~=true then pcall(createFolder,ASSET_FOLDER) end
                end
                pcall(writer,LUCIDE_CACHE,source)
            end
        end
    end
    return LUCIDE_SET
end

-- Aliases so existing icon names keep working against current Lucide naming.
local LUCIDE_ALIASES={
    ["map-pin"]="map-pin",["radio-tower"]="radio-tower",["chevron-down"]="chevron-down",
    ["user-search"]="user-round-search",["loader"]="loader-circle",["gem"]="gem",
    ["pickaxe"]="pickaxe",["shirt"]="shirt",["swords"]="swords",["sword"]="sword",
    ["server"]="server",["settings"]="settings",["users"]="users",["zap"]="zap",
    ["eye"]="eye",["keyboard"]="keyboard",["move"]="move",["search"]="search",
    ["activity"]="activity",
}

function Argon:GetIcon(name)
    local set=loadLucideIndex()
    if not set then return nil end
    local key=LUCIDE_ALIASES[tostring(name)] or tostring(name)
    local entry=set[key] or set[tostring(name)]
    if type(entry)~="table" then return nil end
    local assetId,cell,offset=entry[1],entry[2],entry[3]
    if not (assetId and cell and offset) then return nil end
    return {
        Image="rbxassetid://"..tostring(assetId),
        ImageRectSize=Vector2.new(cell[1],cell[2]),
        ImageRectOffset=Vector2.new(offset[1],offset[2]),
    }
end

function Argon:HasIcon(name) return self:GetIcon(name)~=nil end

local function drawIcon(parent,name,color,size)
    local iconSize=math.max(16,size or 20)
    local holder=create("Frame",{Name="LucideIcon",AnchorPoint=Vector2.new(.5,.5),BackgroundTransparency=1,Position=UDim2.fromScale(.5,.5),Size=UDim2.fromOffset(iconSize,iconSize),Parent=parent})
    local lucide=Argon:GetIcon(name)
    if lucide then
        create("ImageLabel",{Name="LucideGlyph",AnchorPoint=Vector2.new(.5,.5),BackgroundTransparency=1,Image=lucide.Image,ImageColor3=color,ImageRectOffset=lucide.ImageRectOffset,ImageRectSize=lucide.ImageRectSize,Position=UDim2.fromScale(.5,.5),ResampleMode=Enum.ResamplerMode.Default,Size=UDim2.fromScale(1,1),Parent=holder})
        return holder
    end
    local rect=ICON_ATLAS_RECTS[tostring(name)] or ICON_ATLAS_RECTS.activity
    if ICON_ATLAS_IMAGE and rect then
        create("ImageLabel",{Name="VectorAtlasIcon",AnchorPoint=Vector2.new(.5,.5),BackgroundTransparency=1,Image=ICON_ATLAS_IMAGE,ImageColor3=color,ImageRectOffset=rect,ImageRectSize=ICON_ATLAS_CELL,Position=UDim2.fromScale(.5,.5),ResampleMode=Enum.ResamplerMode.Default,Size=UDim2.fromScale(1,1),Parent=holder})
        return holder
    end
    local scale=iconSize/24
    for _,polyline in ipairs(ICONS[tostring(name)] or ICONS.activity) do
        local points={}
        for index,point in ipairs(polyline) do points[index]={point[1]*scale,point[2]*scale} end
        local lineThickness=math.clamp(iconSize/14,1.15,1.65)
        for index=1,#points-1 do iconLine(holder,points[index],points[index+1],color,lineThickness) end
        for _,point in ipairs(points) do
            local capSize=lineThickness
            local cap=create("Frame",{AnchorPoint=Vector2.new(.5,.5),BackgroundColor3=color,BorderSizePixel=0,Position=UDim2.fromOffset(point[1],point[2]),Size=UDim2.fromOffset(capSize,capSize),Parent=holder}) corner(cap,capSize)
        end
    end
    return holder
end

local function recolorIcon(holder,color)
    if not holder then return end
    for _,child in ipairs(holder:GetChildren()) do
        if child:IsA("Frame") then child.BackgroundColor3=color elseif child:IsA("ImageLabel") then child.ImageColor3=color end
    end
end

local function mountLogo(parent,size,logoValue,zIndex)
    local holder=create("Frame",{BackgroundTransparency=1,BorderSizePixel=0,ClipsDescendants=false,Size=UDim2.fromOffset(size,size),ZIndex=zIndex or 1,Parent=parent})
    local image=create("ImageLabel",{AnchorPoint=Vector2.new(.5,.5),BackgroundTransparency=1,Position=UDim2.fromScale(.5,.5),Size=UDim2.fromScale(.96,.96),ScaleType=Enum.ScaleType.Fit,Visible=false,ZIndex=(zIndex or 1)+1,Parent=holder})
    local fallback=create("Frame",{BackgroundColor3=C.Accent,BorderSizePixel=0,ClipsDescendants=true,Size=UDim2.fromScale(1,1),Visible=false,ZIndex=(zIndex or 1)+1,Parent=holder})
    corner(fallback,math.floor(size*.29)) gradient(fallback,C.AccentLight,C.AccentDark,135)
    local mark=create("Frame",{AnchorPoint=Vector2.new(.5,.5),BackgroundTransparency=1,Position=UDim2.fromScale(.5,.5),Size=UDim2.fromScale(.7,.7),ZIndex=(zIndex or 1)+2,Parent=fallback})
    iconLine(mark,{5,19},{12,3},Color3.new(1,1,1),math.max(2,size*.075))
    iconLine(mark,{12,3},{19,19},Color3.new(1,1,1),math.max(2,size*.075))
    iconLine(mark,{8,14},{16,14},Color3.new(1,1,1),math.max(2,size*.075))
    local function setLogo(value)
        local source=tostring(value or "")
        if tonumber(value) then source="rbxassetid://"..tostring(value) end
        local custom=source:match("^rbxassetid://") or source:match("^rbxthumb://")
        local resolved=custom and source or ARGON_LOGO_IMAGE
        image.Image=resolved or ""
        image.Size=UDim2.fromScale(custom and .72 or .96,custom and .72 or .96)
        image.Visible=resolved~=nil and resolved~=""
        fallback.Visible=not image.Visible
    end
    setLogo(logoValue)
    return holder,setLogo
end

local function tween(object,duration,props,style,direction)
    local animation=TweenService:Create(object,TweenInfo.new(duration or .18,style or Enum.EasingStyle.Quart,direction or Enum.EasingDirection.Out),props)
    animation:Play()
    return animation
end

-- Text sharpness: the legacy Gotham enum renders thin and muddy at 8-11px. Mapping to
-- GothamSSm FontFace weights and nudging small sizes up gives noticeably crisper glyphs
-- with the same layout. Falls back to the enum font when FontFace is unavailable.
local FONT_FAMILY="rbxasset://fonts/families/GothamSSm.json"
local FONT_WEIGHTS={
    [Enum.Font.Gotham]=Enum.FontWeight.Medium,
    [Enum.Font.GothamMedium]=Enum.FontWeight.SemiBold,
    [Enum.Font.GothamBold]=Enum.FontWeight.Bold,
    [Enum.Font.GothamBlack]=Enum.FontWeight.Heavy,
}
local FONT_FACES={}
local function fontFaceFor(font)
    if FONT_FACES[font]~=nil then return FONT_FACES[font] or nil end
    local weight=FONT_WEIGHTS[font]
    if not weight then FONT_FACES[font]=false return nil end
    local ok,face=pcall(function() return Font.new(FONT_FAMILY,weight,Enum.FontStyle.Normal) end)
    FONT_FACES[font]=ok and face or false
    return ok and face or nil
end

-- Small text gets a small bump; larger headings are left alone so layout stays put.
local function readableSize(size)
    size=size or 14
    if size<=9 then return size+2 end
    if size<=12 then return size+1 end
    return size
end

local function text(parent,value,size,color,font,props)
    local requested=font or Enum.Font.Gotham
    local label=create("TextLabel",{BackgroundTransparency=1,Text=value or "",TextColor3=color or C.Text,TextSize=readableSize(size),Font=requested,TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Center,Parent=parent})
    local face=fontFaceFor(requested)
    if face then pcall(function() label.FontFace=face end) end
    for property,setting in pairs(props or {}) do
        if property=="TextSize" then label.TextSize=readableSize(setting) else label[property]=setting end
    end
    return label
end

local function bindCanvas(scroller,layout,extra)
    local function update() scroller.CanvasSize=UDim2.fromOffset(0,layout.AbsoluteContentSize.Y+(extra or 0)) end
    connect(layout:GetPropertyChangedSignal("AbsoluteContentSize"),update)
    update()
end

local function resolveParent()
    local parent
    pcall(function() if gethui then parent=gethui() end end)
    return parent or CoreGui
end

local function copy(value)
    if type(value)~="table" then return value end
    local result={}
    for key,nested in pairs(value) do result[key]=copy(nested) end
    return result
end

local function remapColor(value,oldTheme,newTheme)
    for key,oldColor in pairs(oldTheme) do
        if typeof(oldColor)=="Color3" and value==oldColor and typeof(newTheme[key])=="Color3" then return newTheme[key] end
    end
    return value
end

function Argon:AddTheme(name,palette)
    assert(type(name)=="string" and name~="","Theme name must be a non-empty string")
    assert(type(palette)=="table","Theme palette must be a table")
    local merged=copy(self.Themes.Argon)
    for key,value in pairs(palette) do if typeof(value)=="Color3" then merged[key]=value end end
    self.Themes[name]=merged
    return merged
end

function Argon:GetThemes()
    local names={}
    for name in pairs(self.Themes) do table.insert(names,name) end
    table.sort(names)
    return names
end

function Argon:SetTheme(name)
    local nextTheme=type(name)=="table" and name or self.Themes[tostring(name)]
    if not nextTheme then return false,"Unknown theme: "..tostring(name) end
    for key,value in pairs(nextTheme) do if typeof(value)=="Color3" then C[key]=value end end
    self.CurrentTheme=type(name)=="string" and name or "Custom"
    self._themeToken+=1
    local token=self._themeToken
    task.spawn(function()
        local writeIndex=1
        for readIndex,binding in ipairs(self._themeBindings) do
            if token~=self._themeToken then return end
            local object=binding.Object
            if object and object.Parent then
                self._themeBindings[writeIndex]=binding
                writeIndex+=1
                if binding.Points then
                    local points={}
                    for _,point in ipairs(binding.Points) do points[#points+1]=ColorSequenceKeypoint.new(point.Time,point.Key and nextTheme[point.Key] or point.Color) end
                    pcall(function() object[binding.Property]=ColorSequence.new(points) end)
                elseif binding.Key and nextTheme[binding.Key] then
                    -- Repaint unconditionally. The previous version only wrote when the
                    -- property still equalled the OLD palette entry, so anything that was
                    -- mid-tween, hovered, or pressed at the moment of the switch failed the
                    -- comparison and stayed stranded on the previous theme for good. That is
                    -- what produced rows and action badges in one theme's accent while the
                    -- rest of the window used another.
                    pcall(function() object[binding.Property]=nextTheme[binding.Key] end)
                end
            end
            if readIndex%350==0 then task.wait() end
        end
        for index=writeIndex,#self._themeBindings do self._themeBindings[index]=nil end
    end)
    Argon:_fireThemeListeners()
    return true
end

-- Host scripts build their own overlays and panels with raw Color3 values, which is why
-- those windows kept their build-time colours after a theme switch. Palette/GetColor read
-- the live table, and OnThemeChanged lets a host repaint whatever the library does not own.
Argon.Palette=C
function Argon:GetColor(key,fallback)
    local value=C[tostring(key)]
    if typeof(value)=="Color3" then return value end
    return fallback or C.Text
end

function Argon:GetPalette()
    local snapshot={}
    for key,value in pairs(C) do snapshot[key]=value end
    return snapshot
end

function Argon:OnThemeChanged(callback)
    if type(callback)~="function" then return function() end end
    self._themeListeners=self._themeListeners or {}
    table.insert(self._themeListeners,callback)
    return function()
        for index,entry in ipairs(self._themeListeners or {}) do
            if entry==callback then table.remove(self._themeListeners,index) break end
        end
    end
end

function Argon:_fireThemeListeners()
    for _,callback in ipairs(self._themeListeners or {}) do
        local ok,err=pcall(callback,C,self.CurrentTheme)
        if not ok then warn("[Argon UI] Theme listener error: "..tostring(err)) end
    end
end

local function contains(list,value)
    for _,entry in ipairs(list) do if entry==value then return true end end
    return false
end

local function keyName(value)
    if typeof(value)=="EnumItem" then return value.Name end
    local name=tostring(value or "None"):gsub("Enum.KeyCode.","")
    return (name=="" or name=="Unknown") and "None" or name
end

local function encodePosition(value)
    return {XS=value.X.Scale,XO=value.X.Offset,YS=value.Y.Scale,YO=value.Y.Offset}
end

local function decodePosition(value,fallback)
    if type(value)~="table" then return fallback end
    return UDim2.new(tonumber(value.XS) or 0,tonumber(value.XO) or 0,tonumber(value.YS) or 0,tonumber(value.YO) or 0)
end

local FS_ALIASES={
    readfile="read_file",writefile="write_file",isfile="is_file",makefolder="make_folder",
    isfolder="is_folder",listfiles="list_files",delfile="delete_file",
}
local function fsFunction(name)
    local environment=getgenv and getgenv() or _G
    local direct=environment and rawget(environment,name) or nil
    if type(direct)=="function" then return direct end
    direct=rawget(_G,name)
    if type(direct)=="function" then return direct end
    local synTable=(environment and rawget(environment,"syn")) or rawget(_G,"syn")
    local alias=FS_ALIASES[name]
    local candidate=type(synTable)=="table" and alias and synTable[alias] or nil
    return type(candidate)=="function" and candidate or nil
end
local function fileExists(path)
    local check,reader=fsFunction("isfile"),fsFunction("readfile")
    if check then local ok,value=pcall(check,path) return ok and value==true end
    if reader then local ok=pcall(reader,path) return ok end
    return false
end
local function ensureFolder(path)
    if not path or path=="" then return true end
    local check,create=fsFunction("isfolder"),fsFunction("makefolder")
    if check then local ok,value=pcall(check,path) if ok and value==true then return true end end
    if not create then return false,"makefolder is unavailable" end
    local ok,err=pcall(create,path)
    if ok then return true end
    if check then local checkOk,value=pcall(check,path) if checkOk and value==true then return true end end
    return false,tostring(err)
end

local function configPath()
    local config=Argon._configuration
    if not config or not config.Enabled then return nil end
    local folder=config.FolderName or Argon.DefaultFolder
    local file=config.FileName or "Argon"
    -- Respect any extension the host already chose (.json, .cfg, ...) and only fall
    -- back to .rfld so existing Rayfield-style paths keep working unchanged.
    if not file:match("%.[%w_%-]+$") then file=file..(config.FileExtension or ".rfld") end
    return folder.."/"..file,folder
end

local function scheduleSave()
    if not Argon._persistenceReady or Argon._loadingConfig or Argon._destroyed or not configPath() then return end
    Argon._saveToken+=1
    local token=Argon._saveToken
    task.delay(.35,function()
        if token~=Argon._saveToken or not Argon._persistenceReady or Argon._loadingConfig or Argon._destroyed then return end
        local ok,err=Argon:SaveConfiguration()
        Argon._lastAutosaveError=ok and nil or tostring(err)
        if not ok then warn("[Argon UI] Configuration autosave failed: "..tostring(err)) end
    end)
end

-- normal/over are Color3 snapshots taken at call time (Color3 is a value type), so
-- baking them straight into the tween would freeze the button on whatever theme was
-- active when it was built -- SetTheme mutates the C table in place afterwards, and
-- these closures would never look at it again. Instead, resolve each snapshot back
-- to its theme key (if it matches a current C[key]) and re-read C[key] live on every
-- hover event, so a later theme switch is reflected immediately.
local function hover(button,normal,over)
    -- Accepts either a palette key name ("Surface") or a Color3. Keys are always preferred
    -- because they survive a theme switch; a Color3 is only used verbatim when it is not a
    -- palette colour at all (a caller-specific tint).
    local normalKey=type(normal)=="string" and normal or (normal==nil and "Surface" or themeKeyForColor(normal))
    local overKey=type(over)=="string" and over or (over==nil and "Hover" or themeKeyForColor(over))
    local normalColor=typeof(normal)=="Color3" and normal or nil
    local overColor=typeof(over)=="Color3" and over or nil
    connect(button.MouseEnter,function() tween(button,.14,{BackgroundColor3=(overKey and C[overKey]) or overColor or C.Hover}) end)
    connect(button.MouseLeave,function() tween(button,.18,{BackgroundColor3=(normalKey and C[normalKey]) or normalColor or C.Surface}) end)
end

local applyFlagValue

local function registerFlag(flag,element)
    if flag and flag~="" then
        element.Flag=flag
        if Argon.Flags[flag] and Argon.Flags[flag]~=element then warn("[Argon UI] Duplicate configuration flag replaced: "..tostring(flag)) end
        Argon.Flags[flag]=element
        -- A saved value may have arrived before this control existed (deferred tab
        -- construction, dynamic sections). Hydrate it now instead of discarding it.
        local pending=Argon._pendingFlags[flag]
        if pending~=nil and applyFlagValue then
            local wasLoading=Argon._loadingConfig
            Argon._loadingConfig=true
            local ok,err=applyFlagValue(element,pending)
            Argon._loadingConfig=wasLoading
            if ok then Argon._pendingFlags[flag]=nil
            else warn("[Argon UI] Deferred configuration value failed for "..tostring(flag)..": "..tostring(err)) end
        end
    end
end

local function notifyFlagListeners(element)
    if not element or not element.Flag then return end
    local value=element.CurrentValue
    if element.Type=="Dropdown" then value=copy(element.CurrentOption)
    elseif element.Type=="Keybind" then value=element.CurrentKeybind end
    for _,listener in ipairs(Argon._flagListeners) do
        local ok,err=pcall(listener,element.Flag,value,element)
        if not ok then warn("[Argon UI] Flag listener error for "..tostring(element.Flag)..": "..tostring(err)) end
    end
end

local function changed(element)
    notifyFlagListeners(element)
    if element and element._stroke then
        tween(element._stroke,.12,{Color=C.Accent,Transparency=.12})
        task.delay(.25,function() if element._stroke and element._stroke.Parent then tween(element._stroke,.3,{Color=C.BorderSoft,Transparency=.2}) end end)
    end
    scheduleSave()
end

local function normalizeConfigValue(element,value)
    if type(value)=="table" then
        if value.CurrentValue~=nil then value=value.CurrentValue
        elseif element.Type=="Dropdown" and value.CurrentOption~=nil then value=value.CurrentOption
        elseif element.Type=="Keybind" and value.CurrentKeybind~=nil then value=value.CurrentKeybind
        elseif element.Type=="Keybind" and value.Keybind~=nil then value=value.Keybind
        elseif element.Type=="ColorPicker" and value.Object~=nil then value=value.Object
        elseif element.Type=="ColorPicker" and value.Color~=nil then value=value.Color
        elseif value.Value~=nil then value=value.Value end
    end
    if element.Type=="ColorPicker" then
        if typeof(value)=="Color3" then return value end
        if type(value)=="table" then
            if value.__argonColor then
                return Color3.new(tonumber(value.R) or 0,tonumber(value.G) or 0,tonumber(value.B) or 0)
            end
            local red=tonumber(value.R or value.r or value[1])
            local green=tonumber(value.G or value.g or value[2])
            local blue=tonumber(value.B or value.b or value[3])
            if red and green and blue then
                if math.max(red,green,blue)>1 then return Color3.fromRGB(red,green,blue) end
                return Color3.new(red,green,blue)
            end
        end
    end
    return value
end

-- Applies a stored configuration value and guarantees the control's callback runs
-- exactly once. Element:Set only fires callbacks when the value actually changes, so
-- a saved value identical to the element default used to restore visually while the
-- underlying feature was never applied. Setting silently and then invoking the
-- callback ourselves makes autoload deterministic without double-firing.
function applyFlagValue(element,value)
    if not element or not element.Set then return false,"element is not settable" end
    local normalized=normalizeConfigValue(element,value)
    local setOk,setError=pcall(function() element:Set(normalized,true) end)
    if not setOk then return false,setError end
    local callback=element._callback
    if type(callback)=="function" then
        local payload=element.CurrentValue
        if element.Type=="Dropdown" then payload=copy(element.CurrentOption)
        elseif element.Type=="Keybind" then payload=element.CurrentKeybind end
        local callOk,callError=pcall(callback,payload)
        if not callOk then return false,callError end
    end
    notifyFlagListeners(element)
    return true
end

function Argon:GetFlagValue(flag)
    local element=self.Flags[flag]
    if not element then return self._pendingFlags[flag] end
    if element.Type=="Dropdown" then return copy(element.CurrentOption) end
    if element.Type=="Keybind" then return element.CurrentKeybind end
    return element.CurrentValue
end

-- Writes a value into a control (running its callback) or parks it for a control that
-- has not been created yet, mirroring how restored configurations are applied.
function Argon:SetFlagValue(flag,value)
    local element=self.Flags[flag]
    if not element then
        self._pendingFlags[flag]=copy(value)
        scheduleSave()
        return false,"flag is not registered yet; value stored"
    end
    local ok,err=applyFlagValue(element,value)
    if ok then scheduleSave() end
    return ok,err
end

function Argon:GetFlags()
    local values={}
    for flag in pairs(self.Flags) do values[flag]=self:GetFlagValue(flag) end
    for flag,value in pairs(self._pendingFlags) do if values[flag]==nil then values[flag]=copy(value) end end
    return values
end

-- Diagnostics for hosts that want to surface persistence health in their own UI.
function Argon:GetConfigurationStats()
    local path=configPath()
    local pending=0
    for _ in pairs(self._pendingFlags) do pending+=1 end
    local registered=0
    for _ in pairs(self.Flags) do registered+=1 end
    return {
        Path=path,Enabled=path~=nil,Ready=self._persistenceReady==true,Loading=self._loadingConfig==true,
        RegisteredFlags=registered,PendingFlags=pending,LastError=self._lastConfigError,LastAutosaveError=self._lastAutosaveError,
        LastSaveAt=self._lastSaveAt,LastLoadAt=self._lastLoadAt,LastLoad=self._lastConfigStats,
    }
end

function Argon:DeleteConfiguration()
    local path=configPath()
    if not path then return false,"configuration saving is disabled" end
    local remove=fsFunction("delfile")
    if not remove then return false,"delfile is unavailable" end
    if not fileExists(path) then return true,path end
    local ok,err=pcall(remove,path)
    if not ok then return false,tostring(err) end
    return true,path
end

-- Clears stored values and removes the file. Autosave is suspended for the caller so a
-- queued write cannot immediately recreate the deleted configuration.
function Argon:ResetConfiguration()
    self._loadingConfig=true
    self._saveToken+=1
    table.clear(self._pendingFlags)
    local ok,err=self:DeleteConfiguration()
    self._loadingConfig=false
    self._lastConfigStats=nil
    return ok,err
end

-- Fires (flag, value, element) whenever a control value changes, including restores.
function Argon:OnFlagChanged(callback)
    assert(type(callback)=="function","OnFlagChanged expects a function")
    table.insert(self._flagListeners,callback)
    local index=#self._flagListeners
    return function()
        if self._flagListeners[index]==callback then table.remove(self._flagListeners,index) end
    end
end

function Argon:SetPersistenceReady(value,saveImmediately)
    self._persistenceReady=value==true
    self._saveToken+=1
    if self._persistenceReady and saveImmediately==true then return self:SaveConfiguration() end
    return true
end

function Argon:SaveConfiguration()
    local path,folder=configPath()
    if not path then return false,"configuration saving is disabled" end
    local writer=fsFunction("writefile")
    if not writer then return false,"writefile is unavailable" end
    local folderOk,folderError=ensureFolder(folder)
    if not folderOk then
        self._lastConfigError="could not create configuration folder "..tostring(folder)..": "..tostring(folderError)
        return false,self._lastConfigError
    end
    local data={}
    -- Carry unresolved values forward first so saving never erases settings whose
    -- control is not currently built. Live elements overwrite these below.
    for flag,value in pairs(self._pendingFlags) do
        if flag~="__argon" and self.Flags[flag]==nil then data[flag]=copy(value) end
    end
    for flag,element in pairs(self.Flags) do
        if element.Type=="Dropdown" then data[flag]=copy(element.CurrentOption)
        elseif element.Type=="Keybind" then data[flag]=keyName(element.CurrentKeybind or element.CurrentValue)
        elseif element.Type=="ColorPicker" and typeof(element.CurrentValue)=="Color3" then data[flag]={__argonColor=true,R=element.CurrentValue.R,G=element.CurrentValue.G,B=element.CurrentValue.B}
        else data[flag]=copy(element.CurrentValue) end
    end
    local window=self._windows[#self._windows]
    if window and window._exportUIPreferences then data.__argon=window:_exportUIPreferences() end
    local encodeOk,encoded=pcall(function() return HttpService:JSONEncode(data) end)
    if not encodeOk then self._lastConfigError="JSON encode failed: "..tostring(encoded) return false,self._lastConfigError end
    local writeOk,writeError=pcall(writer,path,encoded)
    if not writeOk then self._lastConfigError="could not write "..path..": "..tostring(writeError) return false,self._lastConfigError end
    local reader=fsFunction("readfile")
    if reader then
        local verifyOk,written=pcall(reader,path)
        if not verifyOk or written~=encoded then
            self._lastConfigError="configuration write verification failed for "..path..(verifyOk and " (content mismatch)" or ": "..tostring(written))
            return false,self._lastConfigError
        end
    elseif not fileExists(path) then
        self._lastConfigError="configuration write could not be verified for "..path
        return false,self._lastConfigError
    end
    self._lastConfigError=nil
    self._lastAutosaveError=nil
    self._lastConfigPath=path
    self._lastSaveAt=os.clock()
    return true,path
end

function Argon:LoadConfiguration()
    local path=configPath()
    if not path then return false,"configuration saving is disabled" end
    local reader=fsFunction("readfile")
    if not reader then return false,"readfile is unavailable" end
    if not fileExists(path) then
        -- Nothing to restore: allow autosave so the first change creates the file.
        self._persistenceReady=true
        return false,"configuration file does not exist: "..path
    end
    local readOk,encoded=pcall(reader,path)
    if not readOk then return false,"could not read "..path..": "..tostring(encoded) end
    local decodeOk,data=pcall(function() return HttpService:JSONDecode(encoded) end)
    if not decodeOk or type(data)~="table" then return false,"invalid configuration JSON: "..tostring(data) end
    self._loadingConfig=true
    self._saveToken+=1
    local failures,missing={},{}
    local applied,totalFlags=0,0
    local applyOk,applyError=xpcall(function()
        if type(data.__argon)=="table" then
            self._uiPreferences=copy(data.__argon)
            for _,window in ipairs(self._windows) do
                if window._applyUIPreferences then
                    local ok,err=pcall(function() window:_applyUIPreferences(self._uiPreferences) end)
                    if not ok then failures[#failures+1]="UI preferences: "..tostring(err) end
                end
            end
        end
        local flags={}
        for flag in pairs(data) do if flag~="__argon" then flags[#flags+1]=flag totalFlags+=1 end end
        table.sort(flags,function(left,right)
            local leftBoolean=type(data[left])=="boolean"
            local rightBoolean=type(data[right])=="boolean"
            if leftBoolean~=rightBoolean then return not leftBoolean end
            return tostring(left)<tostring(right)
        end)
        for _,flag in ipairs(flags) do
            local element=self.Flags[flag]
            if element and element.Set then
                self._pendingFlags[flag]=nil
                local ok,err=applyFlagValue(element,data[flag])
                if ok then applied+=1 else failures[#failures+1]=tostring(flag)..": "..tostring(err) end
            else
                -- Keep the value so a control registering later still receives it and
                -- the next save does not silently drop the setting.
                self._pendingFlags[flag]=copy(data[flag])
                missing[#missing+1]=tostring(flag)
            end
        end
    end,function(err) return debug.traceback(tostring(err),2) end)
    self._loadingConfig=false
    self._lastConfigStats={path=path,total=totalFlags,applied=applied,missing=#missing,failed=#failures}
    -- Hydration finished, so autosave can safely take over. Hosts that never call
    -- SetPersistenceReady still get working persistence from here on.
    self._persistenceReady=true
    self._saveToken+=1
    if not applyOk then self._lastConfigError=tostring(applyError) return false,"configuration apply failed: "..tostring(applyError) end
    if totalFlags>0 and applied==0 then
        self._lastConfigError=("configuration contained %d flag(s), but none matched the current UI registry"):format(totalFlags)
        return false,self._lastConfigError
    end
    local warnings={}
    if #failures>0 then warnings[#warnings+1]=("%d value(s) failed: %s"):format(#failures,table.concat(failures," | ",1,math.min(#failures,8))) end
    if #missing>0 then warnings[#warnings+1]=("%d unknown/retired flag(s): %s"):format(#missing,table.concat(missing,", ",1,math.min(#missing,12))) end
    local warning=#warnings>0 and table.concat(warnings," | ") or nil
    if warning then warn("[Argon UI] Configuration loaded with warnings: "..warning) end
    self._lastConfigError=nil
    self._lastConfigPath=path
    self._lastLoadAt=os.clock()
    return true,warning
end

function Argon:Destroy()
    if self._destroyed then return end
    pcall(function() self:SaveConfiguration() end)
    self._destroyed=true
    for _,connection in ipairs(self._connections) do pcall(function() connection:Disconnect() end) end
    for _,window in ipairs(self._windows) do pcall(function() window.ScreenGui:Destroy() end) end
    table.clear(self._connections) table.clear(self._windows) table.clear(self.Flags)
    table.clear(self._pendingFlags) table.clear(self._flagListeners)
    self._librarySettingsCreated=nil
end

function Argon:Notify(options)
    options=options or {}
