__M["persist/Codec"] = function(require)




local Codec={}



function Codec.normalize(kind,value)
if type(value)=="table"then
if value.CurrentValue~=nil then value=value.CurrentValue
elseif kind=="Dropdown"and value.CurrentOption~=nil then value=value.CurrentOption
elseif kind=="Keybind"and value.CurrentKeybind~=nil then value=value.CurrentKeybind
elseif kind=="Keybind"and value.Keybind~=nil then value=value.Keybind
elseif kind=="ColorPicker"and value.Object~=nil then value=value.Object
elseif kind=="ColorPicker"and value.Color~=nil then value=value.Color
elseif value.Value~=nil then value=value.Value end
end
if kind=="ColorPicker"then
return Codec.toColor(value)
end
return value
end


function Codec.toColor(value)
if typeof(value)=="Color3"then return value end
if type(value)=="table"then
if value.__argonColor then
return Color3.new(tonumber(value.R)or 0,tonumber(value.G)or 0,tonumber(value.B)or 0),tonumber(value.A)
end
local r=tonumber(value.R or value.r or value[1])
local g=tonumber(value.G or value.g or value[2])
local b=tonumber(value.B or value.b or value[3])
if r and g and b then
return Color3.fromRGB(r,g,b)
end
elseif type(value)=="string"then
local hex=value:gsub("#","")
if hex:match("^%x%x%x%x%x%x")then
local alpha= #hex>=8 and tonumber(hex:sub(7,8),16)/255 or nil
return Color3.fromRGB(tonumber(hex:sub(1,2),16),tonumber(hex:sub(3,4),16),tonumber(hex:sub(5,6),16)),alpha
end
end
return value
end

function Codec.fromColor(color,alpha)
local record={__argonColor=true,R=color.R,G=color.G,B=color.B}
if alpha and alpha<1 then record.A=alpha end
return record
end

local ALPHABET="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

function Codec.base64(text)
local out={}
for index=1,#text,3 do
local a,b,c=text:byte(index,index+2)
local n=a*65536+(b or 0)*256+(c or 0)
local chars={}
for shift=3,0,-1 do
local digit=math.floor(n/64^shift)%64
chars[#chars+1] =ALPHABET:sub(digit+1,digit+1)
end
if not b then chars[3],chars[4] ="=","="elseif not c then chars[4] ="="end
out[#out+1] =table.concat(chars)
end
return table.concat(out)
end

function Codec.unbase64(text)
text=text:gsub("[^%w%+/=]","")
local out={}
for index=1,#text,4 do
local n,pad=0,0
for offset=0,3 do
local char=text:sub(index+offset,index+offset)
local value=ALPHABET:find(char,1,true)
if char=="="or not value then
pad+=1
value=1
end
n=n*64+(value-1)
end
local a,b,c=math.floor(n/65536)%256,math.floor(n/256)%256,n%256
out[#out+1] =string.char(a)
if pad<2 then out[#out+1] =string.char(b)end
if pad<1 then out[#out+1] =string.char(c)end
end
return table.concat(out)
end

return Codec
end
__M["persist/FS"] = function(require)




local Env=require("core/Env")

local FS={}

function FS.available()
return Env.has("writefile")and Env.has("readfile")
end

function FS.exists(path)
local check=Env.fn("isfile")
if check then
local ok,value=pcall(check,path)
return ok and value==true
end
local reader=Env.fn("readfile")
if reader then return(pcall(reader,path))end
return false
end

function FS.read(path)
local reader=Env.fn("readfile")
if not reader then return nil,"readfile is unavailable"end
if not FS.exists(path)then return nil,"missing"end
local ok,value=pcall(reader,path)
if not ok then return nil,tostring(value)end
return value
end

function FS.ensureFolder(path)
if not path or path==""then return true end
local check,create=Env.fn("isfolder"),Env.fn("makefolder")
if check then
local ok,value=pcall(check,path)
if ok and value==true then return true end
end
if not create then return false,"makefolder is unavailable"end
local ok,err=pcall(create,path)
if ok then return true end
if check then
local checkOk,value=pcall(check,path)
if checkOk and value==true then return true end
end
return false,tostring(err)
end


function FS.write(path,contents)
local writer=Env.fn("writefile")
if not writer then return false,"writefile is unavailable"end
local folder=path:match("^(.*)/[^/]*$")
if folder then

local built=""
for part in folder:gmatch("[^/]+")do
built=built==""and part or(built.."/"..part)
local ok,err=FS.ensureFolder(built)
if not ok then return false,"could not create folder "..built..": "..tostring(err)end
end
end
local ok,err=pcall(writer,path,contents)
if not ok then return false,"could not write "..path..": "..tostring(err)end
local reader=Env.fn("readfile")
if reader then
local verifyOk,written=pcall(reader,path)
if not verifyOk or written~=contents then
return false,"write verification failed for "..path..(verifyOk and" (content mismatch)"or(": "..tostring(written)))
end
elseif not FS.exists(path)then
return false,"write could not be verified for "..path
end
return true
end

function FS.delete(path)
local remove=Env.fn("delfile")
if not remove then return false,"delfile is unavailable"end
if not FS.exists(path)then return true end
local ok,err=pcall(remove,path)
if not ok then return false,tostring(err)end
return true
end


function FS.list(folder,extension)
local lister=Env.fn("listfiles")
if not lister then return{}end
local ok,entries=pcall(lister,folder)
if not ok or type(entries)~="table"then return{}end
local out={}
for _,entry in ipairs(entries)do
local text=tostring(entry):gsub("\\","/")
local inFolder=text:sub(1,#folder+1)==folder.."/"or not text:find("/")
local base=text:match("([^/]+)$")
if inFolder and base and(not extension or base:sub(-#extension)==extension)then
out[#out+1] =extension and base:sub(1,-#extension-1)or base:gsub("%.[^%.]+$","")
end
end
table.sort(out)
return out
end

function FS.encode(value)
return Env.services.HttpService:JSONEncode(value)
end

function FS.decode(text)
local ok,value=pcall(function()return Env.services.HttpService:JSONDecode(text)end)
if ok then return value end
return nil
end

return FS
end
__M["persist/Prefs"] = function(require)





local Signal=require("core/Signal")
local Util=require("core/Util")
local FS=require("persist/FS")
local Store=require("persist/Store")

local Prefs={}
Prefs.table={}
Prefs.changed=Signal.new("Prefs.changed")
Prefs.path=nil
Prefs.meta={v=2}


Prefs.V1={
"Theme","Font","Title","Subtitle","Logo","PlayerListEnabled","KeybindListEnabled",
"OverlaysAlwaysVisible","OverlayTransparency","OverlayScale","SmoothTransitions","OverlayPositions",
}

local function metaPath(config,guiName)
if config and config.Enabled then
local folder=tostring(config.FolderName or"ArgonUI")
local file=tostring(config.FileName or"Argon"):gsub("%.[%w_%-]+$","")
return folder.."/"..file..".meta.json"
end
return"ArgonUI/"..tostring(guiName or"ArgonUI")..".meta.json"
end



function Prefs.loadForWindow(config,guiName,assigned)
local prefs={}
Prefs.path=metaPath(config,guiName)
Prefs.meta={v=2}
local text=FS.read(Prefs.path)
local meta=text and FS.decode(text)
if type(meta)=="table"and type(meta.Prefs)=="table"then
Prefs.meta=meta
for key,value in pairs(meta.Prefs)do prefs[key] =value end
elseif config and config.Enabled then
local path=Store.path()
local legacy=path and FS.read(path)
local data=legacy and FS.decode(legacy)
if type(data)=="table"and type(data.__argon)=="table"then
for key,value in pairs(data.__argon)do prefs[key] =value end
end
end
if type(assigned)=="table"then
for key,value in pairs(assigned)do prefs[key] =value end
end
Prefs.table=prefs
return prefs
end

function Prefs.get(key)
return Prefs.table[key]
end

local saveToken=0
function Prefs.scheduleSave()
if not Prefs.path or not FS.available()then return end
saveToken+=1
local token=saveToken
task.delay(0.35,function()
if token~=saveToken then return end
Prefs.saveNow()
end)
end

function Prefs.saveNow()
if not Prefs.path or not FS.available()then return false end
Prefs.meta.v=2
Prefs.meta.Prefs=Prefs.table
local ok,encoded=pcall(FS.encode,Prefs.meta)
if not ok then return false end
return FS.write(Prefs.path,encoded)
end


Store.afterSave=function()Prefs.saveNow()end


function Prefs.set(key,value,silent)
if Util.jsonEqual(Prefs.table[key],value)then return end
Prefs.table[key] =value
if not silent then Prefs.changed:Fire(key,value)end
Prefs.scheduleSave()
