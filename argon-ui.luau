local Metrics=require("theme/Metrics")
local Icons=require("icons/Icons")

local T,F,TS=Token.T,Token.F,Token.TS
local RowView={}

local function textWidth(text,size)
local service=Env.services.TextService
local ok,bounds=pcall(function()
return service:GetTextSize(text,size,Env.enum("Font","Roboto","Gotham"),Vector2.new(2000,100))
end)
if ok and bounds then return math.ceil(bounds.X*1.04)end
return#text*size*0.55
end
RowView.textWidth=textWidth


function RowView.build(el,scope,opts)
local band=opts.height or Metrics.get("row")
local padH=Metrics.get("padH")
local root=Factory.new(scope,opts.display and"Frame"or"TextButton",{
Name="Control",
BackgroundColor3=T.Hover,
BackgroundTransparency=1,
Size=UDim2.new(1,0,0,band),
LayoutOrder=el._order or 0,
ClipsDescendants=false,
})
if not opts.display then Env.try(root,"Selectable",false)end
local view={Root=root,band=band,padH=padH,reserve=opts.reserve or 0,opts=opts}
if el._inRow==nil then
view.Divider=Factory.new(scope,"Frame",{
Name="Divider",
BackgroundColor3=T.BorderSoft,
Size=UDim2.new(1,-padH*2,0,1),
Position=UDim2.fromOffset(padH,0),
Visible=false,
},root)
end
if opts.title~=false then
view.Title=Factory.text(scope,"TextLabel",{
Name="Title",
Text=el.Name,
FontFace=F.Label,
TextSize=TS.Label,
TextColor3=T.Text,
Position=UDim2.fromOffset(padH,0),
Size=UDim2.new(1,-RowView.titleInset(view),0,band),
TextTruncate=Enum.TextTruncate.AtEnd,
},root)
end
el.Root=root
el._title=view.Title
el._view=view
return view
end

function RowView.titleInset(view)
local reserve=view.reserve or 0
return view.padH*2+(reserve>0 and reserve+16 or 0)
end


function RowView.bandY(view,h)
return math.floor((view.band-h)/2)
end


function RowView.control(view,inst,width,height,rightInset)
inst.AnchorPoint=Vector2.new(1,0)
inst.Position=UDim2.new(1,-(view.padH+(rightInset or 0)),0,RowView.bandY(view,height))
inst.Size=UDim2.fromOffset(width,height)
return inst
end

function RowView.setReserve(el,reserve)
local view=el._view
if not view then return end
view.reserve=reserve
if view.Title then view.Title.Size=UDim2.new(1,-RowView.titleInset(view),0,view.band)end
if view.Description then view.Description.Size=UDim2.new(1,-RowView.titleInset(view),0,0)end
RowView.layoutMarkers(el)
end


function RowView.layoutMarkers(el)
local view=el._view
if not view then return end
if not view.Title then

local lock=el._lock
if lock and lock.Icon then
local mid=math.floor(view.band/2)
lock.Icon.AnchorPoint=Vector2.new(1,0)
lock.Icon.Position=UDim2.new(1,-view.padH,0,mid-7)
lock.Badge.AnchorPoint=Vector2.new(1,0)
lock.Badge.Position=UDim2.new(1,-(view.padH+20),0,mid-10)
end
return
end
local x=view.padH+math.min(textWidth(view.Title.Text,Metrics.textSize("Label")),
math.max(0,view.Root.AbsoluteSize.X-RowView.titleInset(view)))+6
local mid=math.floor(view.band/2)
if view.Changed and view.Changed.Visible then
view.Changed.Position=UDim2.fromOffset(x,mid-3)
x+=12
end
if view.TipMarker and view.TipMarker.Visible then
view.TipMarker.Position=UDim2.fromOffset(x,mid-7)
x+=20
end
if el._lock and el._lock.Icon then
el._lock.Icon.Position=UDim2.fromOffset(x,mid-7)
el._lock.Badge.Position=UDim2.fromOffset(x+18,mid-10)
end
end

function RowView.setDescription(el,text)
local view=el._view
if not view then return end
local root=view.Root
if text and text~=""then
local scope=el._scope
if not view.Description then
view.Description=Factory.text(scope,"TextLabel",{
Name="Description",
FontFace=F.Body,
TextSize=TS.Body,
TextColor3=T.Muted,
TextWrapped=true,
AutomaticSize=Enum.AutomaticSize.Y,
TextYAlignment=Enum.TextYAlignment.Top,
},root)
view.DescPad=Factory.new(scope,"UIPadding",{PaddingBottom=UDim.new(0,Metrics.get("padV"))},root)
end
local desc=view.Description
desc.Visible=true
desc.Text=text
desc.Position=UDim2.fromOffset(view.padH,view.band-12)
desc.Size=UDim2.new(1,-RowView.titleInset(view),0,0)
view.DescPad.PaddingBottom=UDim.new(0,Metrics.get("padV"))
root.Size=UDim2.new(1,0,0,view.band+12)
if view.autoBefore==nil then view.autoBefore=root.AutomaticSize or Enum.AutomaticSize.None end
root.AutomaticSize=Enum.AutomaticSize.Y
el._description=desc
else
if view.Description then
view.Description.Visible=false
view.DescPad.PaddingBottom=UDim.new(0,0)
end

if view.autoBefore~=nil then
root.AutomaticSize=view.autoBefore
view.autoBefore=nil
end
if root.AutomaticSize==nil or root.AutomaticSize==Enum.AutomaticSize.None then
root.Size=UDim2.new(1,0,0,view.band)
end
el._description=nil
end
end

function RowView.setTooltip(el,text)
local view=el._view
if not view or not view.Title then return end
if text and text~=""then
if not view.TipMarker then
view.TipMarker=Factory.new(el._scope,"ImageButton",{
Name="TipMarker",
BackgroundTransparency=1,
Size=UDim2.fromOffset(14,14),
ImageColor3=T.Text2,
},view.Root)
Icons.apply(view.TipMarker,"info",el._scope,T.Text2)
el._scope:connect(view.TipMarker.MouseButton1Click,function()
local window=el._window
if window and window._tooltipHost and el._tooltipText then
window._tooltipHost:schedule(view.Title,el._tooltipText,"press")
end
end)
end
view.TipMarker.Visible=true
el._tipMarker=view.TipMarker
elseif view.TipMarker then
view.TipMarker.Visible=false
el._tipMarker=view.TipMarker
end
RowView.layoutMarkers(el)
end

function RowView.setChanged(el,changed)
local view=el._view
if not view or not view.Title then return end
if changed and not view.Changed then
view.Changed=Factory.new(el._scope,"TextButton",{
Name="Changed",
BackgroundColor3=T.AccentText,
Size=UDim2.fromOffset(6,6),
Visible=false,
},view.Root)
Factory.corner(el._scope,view.Changed,"full")
el._scope:connect(view.Changed.MouseButton1Click,function()el:_resetWithUndo()end)
end
if view.Changed then
view.Changed.Visible=changed==true
RowView.layoutMarkers(el)
end
end


function RowView.setLock(el)
local view=el._view
if not view then return end
local lock=el._lock
if el.Locked then
local scope=el._scope
if not lock then
local scrim=Factory.new(scope,"TextButton",{
Name="LockScrim",
BackgroundColor3=T.Surface,
BackgroundTransparency=0.35,
AnchorPoint=Vector2.new(1,0),
Position=UDim2.new(1,0,0,0),
Size=UDim2.new(0,math.max(view.reserve+view.padH+8,64),0,view.band),
ZIndex=20,
},view.Root)
local icon=Factory.new(scope,"ImageLabel",{
Name="LockIcon",
BackgroundTransparency=1,
Size=UDim2.fromOffset(14,14),
ZIndex=21,
},view.Root)
Icons.apply(icon,"lock",scope,T.Text2)
local badge=Factory.new(scope,"Frame",{
Name="LockReason",
BackgroundColor3=T.Active,
AutomaticSize=Enum.AutomaticSize.X,
Size=UDim2.fromOffset(0,20),
ZIndex=21,
},view.Root)
Factory.corner(scope,badge,6)
Factory.padding(scope,badge,6,6,0,0)
Factory.new(scope,"UISizeConstraint",{MinSize=Vector2.new(0,20),MaxSize=Vector2.new(220,20)},badge)
local label=Factory.text(scope,"TextLabel",{
Name="Label",
AutomaticSize=Enum.AutomaticSize.X,
Size=UDim2.fromScale(0,1),
FontFace=F.Caption,
TextSize=TS.Caption,
TextColor3=T.Text2,
TextTruncate=Enum.TextTruncate.AtEnd,
ZIndex=22,
},badge)
lock={Root=scrim,Badge=badge,Label=label,Icon=icon}
el._lock=lock
scope:connect(scrim.MouseButton1Click,function()el:_lockedPoke()end)
end
local reason=el.LockReason
lock.Badge.Visible=reason~=nil and reason~=""
lock.Label.Text=reason or""
if view.Title then view.Title.TextColor3=Token.resolve(T.Text2)end
RowView.layoutMarkers(el)
elseif lock then
lock.Root:Destroy()
lock.Badge:Destroy()
lock.Icon:Destroy()
el._lock=nil
if view.Title then view.Title.TextColor3=Token.resolve(el._disabled and T.Disabled or T.Text)end
end
end

return RowView
end
__M["container/Builders"] = function(require)




local Tab=require("container/Tab")
local Section=require("container/Section")
local Row=require("container/Row")

local Builders={}

local LOADERS={
Label=function()return require("display/Label")end,
Button=function()return require("controls/Button")end,
ButtonGroup=function()return require("controls/ButtonGroup")end,
Toggle=function()return require("controls/Toggle")end,
Slider=function()return require("controls/Slider")end,
Input=function()return require("controls/Input")end,
Keybind=function()return require("controls/Keybind")end,
Dropdown=function()return require("controls/Dropdown")end,
Paragraph=function()return require("display/Paragraph")end,
TelemetryCard=function()return require("display/TelemetryCard")end,
Divider=function()return require("display/Divider")end,
Space=function()return require("display/Space")end,
ProgressBar=function()return require("display/ProgressBar")end,
Stepper=function()return require("controls/Stepper")end,
Segmented=function()return require("controls/Segmented")end,
TextArea=function()return require("controls/TextArea")end,
List=function()return require("display/List")end,
ColorPicker=function()return require("controls/ColorPicker")end,
Callout=function()return require("display/Callout")end,
Image=function()return require("display/Image")end,
}


local KINDS={
Label={"Label"},Button={"Button"},ButtonGroup={"ButtonGroup"},Toggle={"Toggle"},
Slider={"Slider"},Input={"Input"},Keybind={"Keybind"},Dropdown={"Dropdown"},
Paragraph={"Paragraph"},TelemetryCard={"TelemetryCard"},Divider={"Divider"},Space={"Space"},
ProgressBar={"ProgressBar"},Stepper={"Stepper"},Segmented={"Segmented"},TextArea={"TextArea"},
List={"List"},ColorPicker={"ColorPicker"},Colorpicker={"ColorPicker"},Callout={"Callout"},
Image={"Image"},
Checkbox={"Toggle",function(config)
config=type(config)=="table"and table.clone(config)or{Name=config}
config.Style="Checkbox"
return config
end},
Stat={"TelemetryCard",function(config)
config=type(config)=="table"and table.clone(config)or{Label=config}
config.Variant="stat"
return config
end},
}
Builders.KINDS=KINDS

local function make(kind,ownerOf)
local spec=KINDS[kind]
local loader=LOADERS[spec[1]]
local transform=spec[2]
return function(self,config,...)
local class=loader()
if transform then config=transform(config)end
return class.create(ownerOf(self),config,...)
end
end

local function install(target,ownerOf,skip)
for kind in pairs(KINDS)do
if not(skip and skip[kind])then
local builder=make(kind,ownerOf)
target["Create"..kind] =builder
target[kind] =builder
end
end
end

install(Tab,function(tab)return tab:_currentOrDefault()end)
install(Section,function(section)return section end)
install(Row,function(row)return row:_column()end)

function Section:CreateRow(config)
return Row.create(self,config)
end
Section.Row=Section.CreateRow


function Section:_build(method,...)
local tab=self.Tab
local previous=tab._currentSection
tab._currentSection=self
local results=table.pack(pcall(tab[method],tab,...))
tab._currentSection=previous
if not results[1]then error(results[2],2)end
return table.unpack(results,2,results.n)
end

return Builders
end
__M["container/Registry"] = function(require)





local Registry={}
Registry.__index=Registry

function Registry.new(window)
return setmetatable({window=window,elements={},order=0,deps={},commands={},recent={}},Registry)
end

function Registry:add(element)
self.order+=1
element._regOrder=self.order
self.elements[element] =true
end

function Registry:remove(element)
self.elements[element] =nil
for _,list in pairs(self.deps)do
for index= #list,1,-1 do
if list[index] ==element then table.remove(list,index)end
end
end
end

function Registry:all()
local out={}
for element in pairs(self.elements)do out[#out+1] =element end
table.sort(out,function(a,b)return a._regOrder<b._regOrder end)
return out
end


local function collectFlags(condition,out)
if type(condition)~="table"then return end
if condition.Flag then out[#out+1] =condition.Flag end
for _,key in ipairs({"All","Any"})do
if type(condition[key])=="table"then
for _,inner in ipairs(condition[key])do collectFlags(inner,out)end
end
end
if type(condition.Flags)=="table"then
for _,flag in ipairs(condition.Flags)do out[#out+1] =flag end
end
end

function Registry:watch(element,condition)
local flags={}
collectFlags(condition,flags)
for _,flag in ipairs(flags)do
local list=self.deps[flag]
if not list then
list={}
self.deps[flag] =list
end
list[#list+1] =element
end
end

function Registry:dependents(flag)
return self.deps[flag]or{}
end


function Registry.evaluate(condition,getValue)
if type(condition)=="function"then
local ok,result=pcall(condition,setmetatable({},{__index=function(_,flag)return getValue(flag)end}))
return not ok or result~=false
end
if type(condition)~="table"then return true end
if condition.All then
for _,inner in ipairs(condition.All)do
if not Registry.evaluate(inner,getValue)then return false end
end
return true
end
if condition.Any then
for _,inner in ipairs(condition.Any)do
if Registry.evaluate(inner,getValue)then return true end
end
return false
end
if type(condition.Condition)=="function"then return Registry.evaluate(condition.Condition,getValue)end
local value=getValue(condition.Flag)
if type(value)=="table"and#value==1 then value=value[1]end
if condition.Equals~=nil then return value==condition.Equals end
if condition.NotEquals~=nil then return value~=condition.NotEquals end
if type(condition.In)=="table"then
for _,candidate in ipairs(condition.In)do
if candidate==value then return true end
end
return false
end
return value~=nil and value~=false
end


local function lower(text)return string.lower(tostring(text or""))end

local function words(text)
local out={}
for word in text:gmatch("[%w]+")do out[#out+1] =word end
return out
end



local function scoreField(token,field)
if field==""then return 0,nil end
local start=1
for word in field:gmatch("[%w]+")do
local at=field:find(word,start,true)
if word:sub(1,#token)==token then return 100,at end
start=(at or start)+ #word
end
local at=field:find(token,1,true)
if at then return 60,at end
if#token<3 then return 0,nil end
local position,gaps,last,first=1,0,nil,nil
for index=1,#token do
local found=field:find(token:sub(index,index),position,true)
if not found then return 0,nil end
if last and found>last+1 then gaps+=1 end
if gaps>2 then return 0,nil end
first=first or found
last=found
position=found+1
end
local span=field:sub(first,last)
local _,spaces=span:gsub(" ","")
if spaces>1 then return 0,nil end
return 30-gaps*5,first
end

function Registry.index(element)
local cached=element._searchIndex
if cached then return cached end
local cfg=element._cfg or{}
local keywords={}
if type(cfg.Keywords)=="table"then
for _,keyword in ipairs(cfg.Keywords)do keywords[#keywords+1] =lower(keyword)end
end
local options={}
if element._searchOptions then
for _,option in ipairs(element:_searchOptions())do options[#options+1] =lower(option)end
end
cached={
name=lower(element.Name),
keywords=table.concat(keywords," "),
options=table.concat(options," "),
extra=lower((element._descText or"").." "..(element._tooltipText or"")),
section=lower(element.Section and element.Section.Name or""),
tab=lower(element._tab and element._tab.Name or""),
}
element._searchIndex=cached
return cached
end

local WEIGHTS={{"name",1},{"keywords",0.8},{"options",0.7},{"extra",0.5},{"section",0.5},{"tab",0.4}}

function Registry:score(element,tokens)
local index=Registry.index(element)
local total,firstHit=0,nil
for _,token in ipairs(tokens)do
local best=0
for _,entry in ipairs(WEIGHTS)do
local value,at=scoreField(token,index[entry[1]])
value*=entry[2]
if value>best then
best=value
if entry[1] =="name"then firstHit=at end
end
end
if best<=0 then return 0 end
total+=best
end
total/= #tokens
if self.recent[element]then total+=15 end
return total,firstHit
end


function Registry:search(query,limit,filter)
local tokens=words(lower(query))
local results={}
if#tokens==0 then return results end
local best=0
for element in pairs(self.elements)do
if not element._destroyed and(not filter or filter(element))then
local value,at=self:score(element,tokens)
if value>0 then
results[#results+1] ={el=element,score=value,at=at}
if value>best then best=value end
end
end
end
if best>=60 then
for index= #results,1,-1 do
if results[index].score<25 then table.remove(results,index)end
end
end
table.sort(results,function(a,b)
if a.score~=b.score then return a.score>b.score end
return a.el._regOrder<b.el._regOrder
end)
if limit and#results>limit then
for index= #results,limit+1,-1 do results[index] =nil end
end
return results
end

function Registry:touch(element)
self.recent[element] =os.clock()
end


function Registry:addCommand(command)
self.commands[#self.commands+1] =command
return{
Remove=function()
for index= #self.commands,1,-1 do
if self.commands[index] ==command then table.remove(self.commands,index)end
end
end,
}
end

function Registry:searchCommands(query)
local tokens=words(lower(query))
local out={}
for _,command in ipairs(self.commands)do
local text=lower(command.Name.." "..(command.Description or"").." "..table.concat(command.Keywords or{}," "))
local total=0
for _,token in ipairs(tokens)do
local value=scoreField(token,text)
if value<=0 then
total=0
break
end
total+=value
end
if#tokens==0 then total=1 end
if total>0 then out[#out+1] ={command=command,score=total}end
end
table.sort(out,function(a,b)return a.score>b.score end)
return out
end

return Registry
end
__M["container/Row"] = function(require)





local Token=require("core/Token")
local Factory=require("core/Factory")
local Env=require("core/Env")
local Component=require("component/Component")

local T=Token.T
local Row=Component.extend({ClassName="Row",viewFields={"Root","Layout"}})

local Column={}

local COLUMN_VIEW={Holder=true,Layout=true}
Column.__index=function(column,key)
local method=Column[key]
if method~=nil then return method end
if COLUMN_VIEW[key]then
rawget(column,"_row"):_ensureMounted()
return rawget(column,key)
end
return nil
end

function Row.create(section,config)
if type(config)~="table"then config={Columns=tonumber(config)}end
local count=math.clamp(math.floor(tonumber(config.Columns)or 2),1,4)
local row=Row.new({
Type="Row",
Name=tostring(config.Name or section.Name),
Owner=section,
Section=section,
Elements={},
Columns={},
_spacing=math.clamp(tonumber(config.Spacing)or 7,0,24),
_minWidth=math.clamp(tonumber(config.MinColumnWidth)or 200,80,400),
_next=1,
_tab=section.Tab,
})
for index=1,count do
row.Columns[index] =setmetatable({index=index,Row=row,Section=section,_row=row,_children={}},Column)
end
row._order=section:_addChild(row)
section.Rows[#section.Rows+1] =row

row._balance=function()return row end
row._relayout=function()return row end
return row
end

function Row:_ensureMounted()
if rawget(self,"_mounted")then return end
local body=self.Section:_container()
local scope=self.Section.Tab._pageScope:child("row")
self._scope=scope
self._mounted=true
local root=Factory.new(scope,"Frame",{
Name="Row",
BackgroundTransparency=1,
Size=UDim2.new(1,0,0,0),
AutomaticSize=Enum.AutomaticSize.Y,
LayoutOrder=self._order,
})
local layout=Factory.list(scope,root,{
FillDirection=Enum.FillDirection.Horizontal,
Padding=UDim.new(0,self._spacing),
})
Env.try(layout,"Wraps",true)
Env.try(layout,"HorizontalFlex",Env.enum("UIFlexAlignment","Fill"))
for index,column in ipairs(self.Columns)do
local holder=Factory.new(scope,"Frame",{
Name="Column",
BackgroundTransparency=1,
Size=UDim2.new(1/ #self.Columns,-self._spacing,0,0),
AutomaticSize=Enum.AutomaticSize.Y,
LayoutOrder=index,
},root)
local columnLayout=Factory.list(scope,holder,{})
pcall(function()
Factory.new(scope,"UIFlexItem",{FlexMode=Env.enum("UIFlexMode","Fill")},holder)
end)
Factory.new(scope,"UISizeConstraint",{MinSize=Vector2.new(self._minWidth,0)},holder)
if index>1 then
Factory.new(scope,"Frame",{
Name="Rule",BackgroundColor3=T.BorderSoft,Size=UDim2.new(0,1,1,-24),
Position=UDim2.new(0,-math.ceil(self._spacing/2),0,12),
},holder)
end
column.Holder=holder
column.Layout=columnLayout
end
self.Root=root
self.Layout=layout
self:_childVisibility()
root.Parent=body
end


function Row:_isVisible()
for _,element in ipairs(self.Elements)do
if element:_isVisible()then return true end
end
return#self.Elements==0
end

function Row:_childVisibility()
local root=rawget(self,"Root")
if root then root.Visible=self:_isVisible()end
self.Section:_childVisibility()
end


function Row:Use(index)
self._next=math.clamp(math.floor(tonumber(index)or 1),1,#self.Columns)
return self
end

function Row:_column()
local column=self.Columns[self._next]
self._next=self._next% #self.Columns+1
return column
end


function Column:_addChild(element)
local row=self._row
self._children[#self._children+1] =element
row.Elements[#row.Elements+1] =element
local section=row.Section
section.Elements[#section.Elements+1] =element
section.Tab._orderCounter+=1
return section.Tab._orderCounter
end

function Column:_removeChild(element)
for _,list in ipairs({self._children,self._row.Elements,self._row.Section.Elements})do
for index= #list,1,-1 do
if list[index] ==element then table.remove(list,index)end
end
end
self._row:_childVisibility()
end

function Column:_container()
self._row:_ensureMounted()
return self.Holder
end

function Column:_childVisibility()
self._row:_childVisibility()
end

return Row
end
__M["container/Section"] = function(require)




local Token=require("core/Token")
local Factory=require("core/Factory")
local Motion=require("core/Motion")
local Component=require("component/Component")
local Metrics=require("theme/Metrics")
local Theme=require("theme/Theme")
local Icons=require("icons/Icons")

local T,F,TS=Token.T,Token.F,Token.TS
local Section=Component.extend({ClassName="Section",viewFields={"Root","Body","Layout","Header"}})

function Section.create(tab,config)
if type(config)~="table"then config={Title=config}end
local name=tostring(config.Title or config.Name or"Section")
local section=Section.new({
Name=name,
Tab=tab,
Elements={},
Rows={},
_children={},
_icon=config.Icon,
_desc=config.Description,
_collapsible=config.Collapsible==true,
_collapsed=config.Collapsed==true and config.Collapsible==true,
_hidden=false,
})
section.Section=section
tab._orderCounter+=1
section._order=tab._orderCounter
tab._sections[#tab._sections+1] =section
if tab._skeleton then section:_mountSkeleton()end
tab:_sectionsChanged()
return section
end

function Section:_ensureMounted()
self.Tab:_ensureSkeleton()
end


function Section:_addChild(child)
