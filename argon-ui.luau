self._alpha=self._alphaMode and math.clamp(alpha or(transparency and 1-transparency)or 1,0,1)or 1
self.CurrentValue,self.Color,self.Alpha=color,color,self._alpha
self._h,self._s,self._v=color:ToHSV()
