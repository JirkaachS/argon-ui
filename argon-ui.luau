local function parse(value)
if typeof(value)=="Color3"then return value end
if type(value)=="string"then
local text=value:gsub("%s","")
if text:find(",")then
local r,g,b=text:match("^%D*(%d+%.?%d*),(%d+%.?%d*),(%d+%.?%d*)%D*$")
